# Token del bot de Telegram (te lo da @BotFather)
BOT_TOKEN=tu_token_aqui

# Conexion async (usada por la app / el bot en tiempo de ejecucion)
DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/project_tracker

# Conexion sincrona (usada solo por Alembic para las migraciones)
DATABASE_URL_SYNC=mysql+pymysql://username:password@localhost:3306/project_tracker

# Modo del bot: "polling" (desarrollo) o "webhook" (produccion)
BOT_MODE=polling

# Solo si BOT_MODE=webhook
WEBHOOK_BASE_URL=https://tu-dominio.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=tu_secreto_aqui
